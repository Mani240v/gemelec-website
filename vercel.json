{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/job-request.js": {
      "maxDuration": 90
    },
    "api/purge-photos.js": {
      "maxDuration": 60
    },
    "api/generate-description.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/purge-photos",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/helpmeasap",
      "destination": "/job-request"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
